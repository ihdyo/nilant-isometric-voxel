_system/studio/blender_path.txt

# Python
__pycache__/
*.pyc

# Blender's own backups
*.blend1
*.blend2

# OS
Thumbs.db
desktop.ini
.DS_Store

# render.bat remembers this PC's Python (the Blender path is _system/studio/blender_path.txt above)
_system/studio/render/python_path.txt
